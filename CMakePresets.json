{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "base-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "base-reldeb",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "base-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": { "SAN_ADDR": true }
    },
    {
      "name": "ubsan",
      "hidden": true,
      "cacheVariables": { "SAN_UB": true }
    },
    {
      "name": "lsan",
      "hidden": true,
      "cacheVariables": { "SAN_LEAK": true }
    },
    {
      "name": "tsan",
      "hidden": true,
      "cacheVariables": { "SAN_THREAD": true }
    },

    {
      "name": "debug",
      "inherits": "base-debug"
    },
    {
      "name": "reldeb",
      "inherits": "base-reldeb"
    },
    {
      "name": "release",
      "inherits": "base-release"
    },

    {
      "name": "debug-gcc",
      "inherits": [ "base-debug", "gcc" ]
    },
    {
      "name": "reldeb-gcc",
      "inherits": [ "base-reldeb", "gcc" ]
    },
    {
      "name": "release-gcc",
      "inherits": [ "base-release", "gcc" ]
    },

    {
      "name": "debug-clang",
      "inherits": [ "base-debug", "clang" ]
    },
    {
      "name": "reldeb-clang",
      "inherits": [ "base-reldeb", "clang" ]
    },
    {
      "name": "release-clang",
      "inherits": [ "base-release", "clang" ]
    },

    {
      "name": "debug-asan",
      "inherits": [ "base-debug", "asan" ]
    },
    {
      "name": "reldeb-asan",
      "inherits": [ "base-reldeb", "asan" ]
    },
    {
      "name": "release-asan",
      "inherits": [ "base-release", "asan" ]
    },
    {
      "name": "debug-tsan",
      "inherits": [ "base-debug", "tsan" ]
    },
    {
      "name": "reldeb-tsan",
      "inherits": [ "base-reldeb", "tsan" ]
    },
    {
      "name": "release-tsan",
      "inherits": [ "base-release", "tsan" ]
    },
    {
      "name": "debug-aublsan",
      "description": "combining addr, ub and leak sanitizers is widely supported on many platforms",
      "inherits": [ "base-debug", "asan", "ubsan", "lsan" ]
    }
  ]
}
